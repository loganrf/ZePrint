# Stack environment for docker-compose.yml / deploy/compose.yaml.
# Copy to .env (plain Docker) or paste into your stack manager's env editor.

# The networked printer's raw port (required on first start)
ZEPRINT_PRINTER_URI=tcp://192.168.1.50:9100
ZEPRINT_PRINTER_NAME=Zebra GX430t
ZEPRINT_PRINTER_DPI=300
ZEPRINT_LABEL_SIZE=4x6

TZ=America/Los_Angeles
ZEPRINT_HTTP_PORT=8080
# ZEPRINT_IMAGE=ghcr.io/loganrf/zeprint:latest

# Optional: require "Authorization: Bearer <token>" on /api
ZEPRINT_API_TOKEN=

# Optional: Home Assistant via MQTT discovery
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Link shown on the HA device page
ZEPRINT_URL=
